# Set these in Vercel > Project > Settings > Environment Variables.
# This template has no real credentials. Do not commit .env or browser-exposed secrets.
PAGESQUIRE_PROVIDER=sumopod
PAGESQUIRE_API_KEY=
PAGESQUIRE_MODEL=gpt-4o-mini
PAGESQUIRE_ALLOW_REMOTE=true
# Optional: your exact custom domain origin, without path/trailing slash.
# Leave UNSET in Vercel to use trusted VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL.
PAGESQUIRE_ORIGIN=
# Shared Supabase database, isolated kabarin_pagesquire schema. No Supabase API keys needed.
# Copy Supabase > Connect > Transaction pooler (port 6543), including username/password.
# Format: postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
# Run npm run db:setup once after filling DATABASE_URL locally.
PAGESQUIRE_STORE=postgres
DATABASE_URL=
PAGESQUIRE_APP_ID=kabarin
# Required stable secrets for the public demo. Generate each separately (32+ random bytes).
PAGESQUIRE_SESSION_SECRET=
PAGESQUIRE_QUOTA_SECRET=
# Public Vercel deployments always enforce the demo guards, regardless of this flag.
PAGESQUIRE_PUBLIC_DEMO=true
# Fixed safety caps: 5 new messages/network/day, 25 provider calls/network/day,
# 50 messages/site/day, 100 provider calls/site/day. Days reset at 00:00 UTC.
PAGESQUIRE_RESPONSE_MODE=json_object
PAGESQUIRE_TOKEN_PARAMETER=max_tokens
PAGESQUIRE_TIMEOUT_SECONDS=30
PAGESQUIRE_MAX_OUTPUT_TOKENS=1600
PAGESQUIRE_SITE_REQUESTS_PER_MINUTE=120
