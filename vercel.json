{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.mjs": {
      "maxDuration": 60,
      "includeFiles": "{server/**,integration/capabilities.json,integration/news/*.json}"
    }
  },
  "rewrites": [
    {"source":"/api/news.php","destination":"/api/news"},
    {"source":"/api/assistant-session.php","destination":"/api/assistant-session"},
    {"source":"/api/assistant-chat.php","destination":"/api/assistant-chat"},
    {"source":"/api/assistant-reset.php","destination":"/api/assistant-reset"}
  ],
  "headers": [
    {"source":"/","headers":[{"key":"Cache-Control","value":"public, max-age=0, must-revalidate"}]},
    {"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"}]}
  ]
}
