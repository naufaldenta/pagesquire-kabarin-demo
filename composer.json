{
  "name": "kabarin/news-portal",
  "description": "Local Kabarin PageSquire PHP integration",
  "type": "project",
  "repositories": [{ "type": "path", "url": ".vendor/pagesquire/packages/php", "options": { "symlink": false, "versions": { "pagesquire/server": "0.1.0-alpha.0" } } }],
  "require": { "php": "^8.3", "ext-curl": "*", "ext-mbstring": "*", "ext-simplexml": "*", "pagesquire/server": "0.1.0-alpha.0", "vlucas/phpdotenv": "^5.6" },
  "autoload": { "psr-4": { "Kabarin\\Assistant\\": "integration/php/", "Kabarin\\News\\": "integration/news/" } },
  "config": { "allow-plugins": false, "sort-packages": true },
  "minimum-stability": "alpha",
  "prefer-stable": true
}
