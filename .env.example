# Local Laragon settings. For Vercel use .env.vercel.example instead.
# Provider credentials are read only by the server, never by browser JS.
PAGESQUIRE_PROVIDER=sumopod
PAGESQUIRE_API_KEY=
# Exact text-chat model ID available in your SumoPod account.
PAGESQUIRE_MODEL=gpt-4o-mini
# Origin only; no trailing slash or application path.
PAGESQUIRE_ORIGIN=http://localhost
# Local use by default. Review quotas/access before enabling remote visitors.
PAGESQUIRE_ALLOW_REMOTE=false
# Private directory OUTSIDE the web document root. Adjust for your machine.
PAGESQUIRE_STORAGE_DIR=C:/Users/asus/AppData/Local/Kabarin/PageSquire
PAGESQUIRE_RESPONSE_MODE=json_object
PAGESQUIRE_TOKEN_PARAMETER=max_tokens
PAGESQUIRE_TIMEOUT_SECONDS=30
PAGESQUIRE_MAX_OUTPUT_TOKENS=1600

# Node/Vercel PageSquire storage. PHP Laragon continues to use its private file store.
# Fill ONLY DATABASE_URL below with Supabase > Connect > Transaction pooler (port 6543).
# Example format: postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
# Use the exact host from your Supabase dashboard; percent-encode password special characters.
# Then run npm run db:setup once. No Supabase anon/service-role keys or Redis needed.
PAGESQUIRE_STORE=postgres
DATABASE_URL=
# Separate Kabarin sessions from other apps sharing this database.
PAGESQUIRE_APP_ID=kabarin
